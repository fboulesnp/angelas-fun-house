{
  "name": "angelas-fun-house",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Angela's Fun House — a science pinball adventure for seventh grade.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
